# Dépendance tierce (projet HairFastGAN cloné en local, ~12 Go avec les
# poids pré-entraînés) — voir le README pour le lien vers le dépôt original.
HairFastGAN/

# Python
__pycache__/
*.pyc
.venv/

# État local d'outils (agents IA, etc.), pas du code du projet.
.claude/

# Transformer FLUX Kontext quantifie en FP8 (~11 Go), regenere localement
# au premier lancement de run_kontext.py — voir son docstring.
models/flux_kontext_transformer_fp8/

# Logs/chronos des essais de reglages de run_kontext.py (pas des artefacts utiles)
results/_kontext_*.log
results/_run*_start.txt
results/_run*_timing.txt

# Photos des testeurs de la cabine coiffure IA (cabine_server.py) + resultats
# generes pendant une session -> donnees personnelles d'un tiers, jamais
# commitees (voir specs/cabine-coiffure-ia.html).
server_sessions/

# Photos generees par run_kontext.py (visage reel de l'auteur avec diverses
